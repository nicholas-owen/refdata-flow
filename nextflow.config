manifest {
    name            = 'refdata-flow'
    description     = 'Download reference genomes and annotations and catalogue them in a refgenie vault'
    author          = 'Nicholas Owen'
    homePage        = 'https://github.com/nicholas-owen/refdata-flow'
    mainScript      = 'main.nf'
    version         = '0.9.1'

    // Enforced by Nextflow: an older version aborts immediately with a clear
    // message instead of failing further in with a syntax or runtime error.
    // 25.04 is the floor because it is the first release requiring Java 17, and
    // because main.nf is written for the strict syntax parser (the default from
    // 26.04). Tested against 26.04.x; CI lints with 26.04.4.
    nextflowVersion = '>=25.04'
}

params {
    // Input CSV file (generated by bin/resolve.py)
    input = 'requests_resolved.csv'
    
    // Output directory (can be overridden via command line: --outdir /path/to/storage)
    outdir = 'data/references'

    // Stream per-task download progress to the console (process `debug`).
    // Off by default; enabled by `run_pipeline.sh --debug` (passes --debug true).
    debug = false
}

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled = true
        // Version synced to the conda profile / requirements.txt (genomepy 0.16.4).
        // NOTE: the build suffix below was not verified against quay.io. Docker is
        // not part of the supported/tested path; before using this profile, confirm
        // the exact tag at https://quay.io/repository/biocontainers/genomepy?tab=tags
        process.container = 'quay.io/biocontainers/genomepy:0.16.4--pyhdfd78af_0'
    }
    conda {
        conda.enabled = true
        // Pin genomepy to match requirements.txt (the download stage and the
        // venv/refgenie stage must agree on the genomepy version).
        //
        // The ucsc-* tools are what genomepy shells out to for gene annotation
        // conversion (genePredToGtf and friends). They are declared explicitly
        // rather than relied on as a transitive dependency of the genomepy
        // package: annotation is a headline feature, and its toolchain should be
        // visible here instead of being an implicit property of someone else's
        // recipe. A pip-only environment cannot supply them at all, which is why
        // bin/download.py preflights for them and exits 3 with the install
        // command when they are absent.
        //
        // samtools/htslib are here for the same reason: genomepy shells out to
        // `bgzip` (htslib) and refgenie's fasta recipe to `samtools faidx`. Without
        // them the task silently falls through to the pysam-backed shims that
        // run_pipeline.sh writes into .venv/bin - which works only when the wrapper
        // put them on PATH. Invoking `nextflow run -profile conda` directly would
        // otherwise have no bgzip at all.
        //
        // TODO: pin the ucsc-*/samtools/htslib versions once a known-good set has
        // been confirmed on a real run; unpinned entries here are at odds with the
        // hash-locked requirements.txt and undermine the reproducibility claim.
        process.conda = 'bioconda::genomepy=0.16.4 bioconda::samtools bioconda::htslib ' +
                        'bioconda::ucsc-genepredtogtf bioconda::ucsc-gtftogenepred ' +
                        'bioconda::ucsc-genepredtobed bioconda::ucsc-bedtogenepred ' +
                        'bioconda::ucsc-gff3togenepred'

        // An eight-package bioconda solve can exceed Nextflow's 20-minute default
        // and abort the run after all that waiting. Raised rather than risk it.
        // If mamba is available (miniforge ships it), `conda.useMamba = true` cuts
        // the solve dramatically - left off here because it fails outright when
        // mamba is absent.
        conda.createTimeout = '60.min'
    }
}
